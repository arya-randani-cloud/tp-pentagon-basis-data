// =====================================================================
// ERD Sistem Peminjaman dan Pengembalian Buku - Tim PENTAGON
// Skema DBML Lengkap (5 Tabel: anggota, buku, petugas, peminjaman, pengembalian)
// =====================================================================

Table anggota {
  id_anggota varchar(10) [pk, note: 'Primary Key Anggota']
  nama_anggota varchar(100) [not null]
  alamat varchar(255)
  no_telepon varchar(15)
  email varchar(100)
  tanggal_daftar date [not null]

  Note: 'Tabel yang menyimpan data identitas anggota perpustakaan'
}

Table buku {
  id_buku varchar(10) [pk, note: 'Primary Key Buku']
  judul_buku varchar(150) [not null]
  pengarang varchar(100)
  penerbit varchar(100)
  tahun_terbit smallint
  kategori varchar(50)
  stok int [not null, default: 0]

  Note: 'Tabel yang menyimpan data katalog buku perpustakaan'
}

Table petugas {
  id_petugas varchar(10) [pk, note: 'Primary Key Petugas']
  nama_petugas varchar(100) [not null]
  username varchar(50) [unique, not null]
  password varchar(255) [not null]
  hak_akses varchar(20) [not null]
  no_telepon varchar(15)

  Note: 'Tabel yang menyimpan data akun petugas/operator perpustakaan'
}

Table peminjaman {
  id_peminjaman varchar(15) [pk, note: 'Primary Key Peminjaman']
  id_anggota varchar(10) [not null, note: 'FK ke tabel anggota']
  id_buku varchar(10) [not null, note: 'FK ke tabel buku']
  id_petugas varchar(10) [not null, note: 'FK ke tabel petugas']
  waktu_peminjaman datetime [not null]

  Note: 'Tabel transaksi pencatatan peminjaman buku oleh anggota'
}

Table pengembalian {
  id_pengembalian varchar(15) [pk, note: 'Primary Key Pengembalian']
  id_peminjaman varchar(15) [unique, not null, note: 'FK ke tabel peminjaman (1:1 / 1:0..1)']
  id_petugas varchar(10) [not null, note: 'FK ke tabel petugas']
  waktu_pengembalian datetime [not null]

  Note: 'Tabel transaksi pencatatan pengembalian buku'
}

// Relasi ke Peminjaman
Ref: peminjaman.id_anggota > anggota.id_anggota [delete: cascade, update: cascade]
Ref: peminjaman.id_buku > buku.id_buku [delete: cascade, update: cascade]
Ref: peminjaman.id_petugas > petugas.id_petugas [delete: cascade, update: cascade]

// Relasi ke Pengembalian
Ref: pengembalian.id_peminjaman - peminjaman.id_peminjaman [delete: cascade, update: cascade]
Ref: pengembalian.id_petugas > petugas.id_petugas [delete: cascade, update: cascade]

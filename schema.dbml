Project ecommerce_db {
  database_type: 'MySQL'
  Note: 'Skema Basis Data Proyek eCommerce UTS'
}

Table users {
  id bigint [pk, increment]
  name varchar(100) [not null]
  email varchar(150) [not null, unique]
  password varchar(255) [not null]
  phone varchar(20) [unique]
  address text
  created_at timestamp
  updated_at timestamp

  Indexes {
    name [name: 'idx_users_name']
  }
}

Table categories {
  id bigint [pk, increment]
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  description text
  created_at timestamp
  updated_at timestamp

  Indexes {
    name [name: 'idx_categories_name']
  }
}

Table products {
  id bigint [pk, increment]
  category_id bigint [not null, ref: > categories.id]
  sku varchar(50) [not null, unique]
  name varchar(200) [not null]
  description text
  price decimal(12,2) [not null]
  stock int [not null, default: 0]
  status varchar(20) [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  Indexes {
    name [name: 'idx_products_name']
    (category_id, status) [name: 'idx_products_category_status']
    price [name: 'idx_products_price']
  }
}

Table orders {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  invoice_number varchar(50) [not null, unique]
  total_price decimal(12,2) [not null]
  status varchar(30) [not null, default: 'pending']
  order_date datetime [not null]
  created_at timestamp
  updated_at timestamp

  Indexes {
    status [name: 'idx_orders_status']
    order_date [name: 'idx_orders_date']
  }
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  product_id bigint [not null, ref: > products.id]
  quantity int [not null]
  unit_price decimal(12,2) [not null]
  subtotal decimal(12,2) [not null]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (order_id, product_id) [name: 'idx_order_items_order_product']
  }
}

